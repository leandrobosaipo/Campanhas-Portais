ADOPS_PERRENGUE_CONTAINER_PHP_BIN=php
ADOPS_PERRENGUE_CONTAINER_WP_CLI_PATH=wp
ADOPS_PERRENGUE_PORTAINER_TLS_INSECURE=true
ADOPS_PERRENGUE_REBUILD_TIMEOUT_MS=600000
ADOPS_PERRENGUE_REBUILD_POLL_INTERVAL_MS=5000

