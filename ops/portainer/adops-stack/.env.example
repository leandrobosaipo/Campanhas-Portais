PORTAINER_API_KEY=change-me
ADOPS_PERRENGUE_ADROTATE_EXEC_MODE=portainer
ADOPS_PERRENGUE_PORTAINER_ENDPOINT_ID=3
ADOPS_PERRENGUE_WP_CONTAINER=cod5-pro119-perrenguematogrosso-app
