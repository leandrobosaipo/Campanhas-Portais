FROM mcr.microsoft.com/playwright:v1.59.1-noble AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PNPM_HOME=/pnpm \
    PATH=/pnpm:/root/.local/bin:$PATH

WORKDIR /app

RUN corepack enable \
 && corepack prepare pnpm@10.14.0 --activate \
 && apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-pip python3-pil zip curl ca-certificates git openssh-client poppler-utils postgresql-client ffmpeg \
 && python3 -m pip install --break-system-packages --no-cache-dir awscli \
 && rm -rf /var/lib/apt/lists/* \
 && curl -LsSf https://astral.sh/uv/install.sh | sh \
 && command -v uv \
 && command -v uvx \
 && command -v pdftotext \
 && command -v pdfinfo \
 && command -v ffmpeg \
 && command -v ffprobe \
 && command -v pnpm

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json tsconfig.base.json .npmrc ./
COPY lib ./lib
COPY artifacts/api-server ./artifacts/api-server
COPY artifacts/adops/public/site-logos ./artifacts/adops/public/site-logos
COPY scripts ./scripts
COPY config ./config
COPY ops/cloudflare-remote-runner ./ops/cloudflare-remote-runner
COPY ops/telegram-adapter ./ops/telegram-adapter

RUN pnpm install --frozen-lockfile --prod=false \
 && pnpm --filter @workspace/api-server run build

ENV ADOPS_PROJECT_ROOT=/app \
    ADOPS_TSX_BIN=/app/node_modules/.bin/tsx \
    CAMPANHAS_PORTAIS_ROOT=/app \
    ADOPS_GENERATED_PRINTS_ROOT=/app/tmp/generated-prints \
    NODE_ENV=production \
    TZ=America/Cuiaba

RUN mkdir -p /app/tmp/generated-prints

EXPOSE 4011

CMD ["node", "artifacts/api-server/dist/index.mjs"]

FROM runtime AS web-build

ARG VITE_API_BASE_URL=https://adops-api.codigo5.com.br
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    NODE_ENV=production

COPY artifacts/adops ./artifacts/adops
COPY attached_assets ./attached_assets

RUN pnpm --filter @workspace/adops run build

FROM nginx:1.27-alpine AS web

COPY ops/portainer/adops-stack/nginx-adops-web.conf /etc/nginx/conf.d/default.conf
COPY --from=web-build /app/artifacts/adops/dist/public /usr/share/nginx/html

EXPOSE 80
