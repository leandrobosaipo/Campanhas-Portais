{
  "name": "adops-api-public",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-13",
  "workers_dev": true,
  "triggers": {
    "crons": ["0,15,30 0,1,2,12,21,22,23 * * *"]
  },
  "vars": {
    "PRIVATE_ADOPS_API_BASE_URL": "https://adops-api.codigo5.com.br",
    "ADOPS_CONTROL_PLANE_PROVIDER": "macmini"
  },
  "d1_databases": [
    {
      "binding": "adops_ops",
      "database_name": "adops-ops",
      "database_id": "79b19c82-924b-4d90-8d33-f5d26aa2753d"
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "adops-ops-queue",
        "binding": "adops_ops_queue"
      }
    ],
    "consumers": [
      {
        "queue": "adops-ops-queue"
      }
    ]
  }
}
