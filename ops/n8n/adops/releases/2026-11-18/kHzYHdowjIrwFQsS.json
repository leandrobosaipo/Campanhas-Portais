    {
      "id": "ba535dec-5018-4900-95ef-d24c7f7fc780",
      "name": "Operação e referência permitidas?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        672,
        192
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ [\"readiness\",\"preview\",\"confirm\",\"apply\",\"preview-status\",\"action-status\"].includes($json.action) && ([\"readiness\",\"preview\"].includes($json.action) || /^[a-f0-9-]{36}$/i.test($json.resourceId)) && (![\"preview\",\"confirm\",\"apply\"].includes($json.action) || ($json.idempotencyKey.length >= 8 && $json.idempotencyKey.length <= 160)) }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "c1b5b0b1-e1db-4061-a107-a1980d89cebc",
      "name": "Preparar confirmar ou aplicar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        896,
        96
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ [\"preview\",\"confirm\",\"apply\"].includes($(\"Normalizar operação restrita\").first().json.action) }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "80e0ca46-c184-4176-99f0-b3619700c9de",
      "name": "Executar recurso com chave única",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ \"https://adops-api.codigo5.com.br/api/monitoring/campaign-actions/\" + ($(\"Normalizar operação restrita\").first().json.action === \"preview\" ? \"previews\" : ($(\"Normalizar operação restrita\").first().json.action === \"confirm\" ? \"previews/\" + encodeURIComponent($(\"Normalizar operação restrita\").first().json.resourceId) + \"/confirm\" : \"actions/\" + encodeURIComponent($(\"Normalizar operação restrita\").first().json.resourceId) + \"/apply\")) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ $(\"Normalizar operação restrita\").first().json.idempotencyKey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.parse($(\"Normalizar operação restrita\").first().json.bodyJson) }}",
        "options": {
          "timeout": 110000
        }
      },
      "credentials": {
