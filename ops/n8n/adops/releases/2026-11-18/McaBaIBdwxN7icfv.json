    {
      "id": "607e49b0-2cf4-41f6-bea2-e0174c22016b",
      "name": "Identificar fluxo e etapa sem expor segredos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const x=$input.first().json;const manual=!x.workflow&&!x.execution;const workflow_id=String(x.workflow?.id||'adops-alert-validation');const execution_id=String(x.execution?.id||'validation-20261117-v1');const stage=String(x.execution?.lastNodeExecuted||x.trigger?.error?.node?.name||'Validação do aviso').replace(/[\\r\\n]/g,' ').slice(0,120);const raw=String(x.execution?.error?.message||x.trigger?.error?.message||'');const reason=manual?'Teste controlado da notificação de falhas.':/timeout|timed out|ETIMEDOUT/i.test(raw)?'O serviço não respondeu dentro do prazo.':/ECONNREFUSED|unavailable|503|502/i.test(raw)?'Serviço indisponível ou conexão recusada.':/memory|heap|ENOMEM/i.test(raw)?'Falha relacionada à memória; conferir o servidor.':/401|403|unauthorized/i.test(raw)?'Acesso recusado pelo serviço; conferir a credencial.':'A etapa registrou uma falha técnica. O diagnóstico completo foi preservado na execução.';const workflow=String(x.workflow?.name||'AdOps — tratamento de erros').replace(/[\\r\\n]/g,' ').slice(0,120);const incident_key=manual?'adops-alert-validation-20261117-v1':[workflow_id,stage,Math.floor(Date.now()/1800000)].join(':');return [{json:{incident_key,workflow_id,execution_id,stage,status:'delivery_unknown',provider_id:'',message:[manual?'*Teste do alerta AdOps*':'*Rotina AdOps interrompida*','Fluxo: '+workflow,'Etapa: '+stage,'Motivo: '+reason,'Execução: '+execution_id,'Próximo passo: consultar esta execução e o mesmo trabalho antes de repetir publicação ou envio. As retentativas técnicas têm limite; uma tentativa de envio sem recibo não será reenviada automaticamente.','Este alerta funciona pelo n8n mesmo quando a API AdOps está indisponível.'].join('\\n')}}];"
      }
    },
