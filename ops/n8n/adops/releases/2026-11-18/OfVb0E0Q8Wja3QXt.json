      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        464
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const run = $(\"Fixar data de referência e manifesto\").first().json;\nconst date = String(run.date || \"\");\nconst audit = $input.first().json;\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(date) || audit.date !== date || !Array.isArray(audit.items) || audit.totalEligible !== audit.items.length) throw new Error(\"daily_manifest_incomplete\");\nconst ids = audit.items.map(x => Number(x.insertionId));\nif (ids.some(x => !Number.isSafeInteger(x) || x <= 0) || new Set(ids).size !== ids.length) throw new Error(\"daily_manifest_identity_invalid\");\nreturn ids.map(insertionId => ({json:{insertionId,date}}));"
      }
    },
