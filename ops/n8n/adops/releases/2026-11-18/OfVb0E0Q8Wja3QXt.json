      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ (() => { const id = Number($(\"Gerar itens únicos de inserção/data\").item.json.insertionId); const date = String($(\"Gerar itens únicos de inserção/data\").item.json.date); const jobs = [...($(\"Consultar capturas ativas individuais\").first().json.items || []), ...($(\"Consultar lotes de captura ativos\").first().json.items || []), ...($(\"Consultar backfills de captura ativos\").first().json.items || [])]; return jobs.some(j => { const p = j.payload || {}; if (![\"queued\",\"ready_for_runner\",\"running\"].includes(j.status)) return false; if (j.kind === \"print-single\") return Number(p.insertionId) === id && String(p.date || \"\") === date; if (j.kind === \"print-backfill\") return Number(p.insertionId) === id && (!p.fromDate || String(p.fromDate) <= date) && (!p.toDate || String(p.toDate) >= date); if (j.kind === \"print-batch\") return String(p.date || p.targetDate || \"\") === date && (!Array.isArray(p.insertionIds) || p.insertionIds.map(Number).includes(id)); return false; }); })() }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
