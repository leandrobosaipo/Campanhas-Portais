    {
      "id": "3230fa55-7cbf-4a8d-a008-d998e72f17be",
      "name": "Restaurar binário sem copiar storage privado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1730,
        -200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const source=$('Baixar PNG auditado privado').first();return [{json:$input.first().json,binary:source.binary}];"
      }
    },
    {
      "id": "6ec5b24d-8beb-4d69-9af9-3a800eafd56e",
      "name": "Preparar arquivo auditado sem URL privada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1740,
        -200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const data=$('Conferir identidade do print real').first().json;\nconst bytes=await this.helpers.getBinaryDataBuffer(0,'auditPrint');\nif(bytes.length>20*1024*1024||bytes.length<8||!bytes.subarray(0,8).equals(Buffer.from([137,80,78,71,13,10,26,10])))throw Error('invalid_audited_png');\nif($input.first().json.auditedSha256!==data.sha256)throw Error('audited_png_hash_changed');\nreturn [{json:{number:\"120363431261379098@g.us\",mediatype:'image',mimetype:'image/png',caption:data.caption,media:bytes.toString('base64'),fileName:'print-'+data.insertionId+'-'+data.date+'.png'}}];"
      }
    },
