    {
      "id": "ad5f8413-94fa-4b2d-9a6e-af0e673691ed",
      "name": "Conferir identidade do print real",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        -200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item=$('Reservar uma resposta do menu').first().json.items[0],p=item?.request?._auditedPrint;\nif(item.part!=='image'||item.instance!=='cod5-pmt-pilot'||item.request.number!==\"120363431261379098@g.us\"||!Number.isSafeInteger(p?.insertionId)||p.insertionId<=0||!/^\\d{4}-\\d{2}-\\d{2}$/.test(p.date)||!Number.isSafeInteger(p.evidenceId)||p.evidenceId<=0||!/^[a-f0-9]{64}$/.test(p.sha256))throw Error('invalid_audited_print_identity');\nconst path='/api/monitoring/whatsapp/menu/prints/'+p.insertionId+'?date='+p.date+'&evidenceId='+encodeURIComponent(p.evidenceId)+'&sha256='+p.sha256;\nif(item.downloadPath!==path||typeof item.request.text!=='string')throw Error('invalid_audited_print_path');\nreturn [{json:{...p,caption:item.request.text,downloadPath:path,messageKey:item.messageKey}}];"
      }
    },
