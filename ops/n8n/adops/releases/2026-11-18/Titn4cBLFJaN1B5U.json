        "jsCode": "const c=$(\"Conferir destino e identidade da reserva\").first().json,r=$input.first().json,key=r.body?.key;\nconst accepted=r.statusCode>=200&&r.statusCode<300&&key?.remoteJid===\"120363431261379098@g.us\"&&key.fromMe===true&&typeof key.id==='string'&&key.id.length>0;\nif(!accepted)throw Error('provider_delivery_unknown_do_not_resend');\nreturn [{json:{deliveryId:c.deliveryId,claimToken:c.claimToken,receipt:{key:{id:key.id,remoteJid:key.remoteJid,fromMe:key.fromMe},status:r.body.status}}}];"
