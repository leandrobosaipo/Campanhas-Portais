    {
      "id": "0624dc7c-f522-274e-8265-ebcbabca3b15",
      "name": "Conferir PNG e preparar imagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const inputs=$input.all(),c=$(\"Conferir destino e identidade da reserva\").first().json;\nif(inputs.length!==1)throw Error('expected_one_download');\nconst item=inputs[0],p=item.json;\nif(p.ready!==true||p.publicationEnabled!==false||p.isPublicationEvidence!==false||p.insertionId!==c.insertionId||\n p.revision!==c.revision||p.sha256!==c.sha256||item.binary?.preview?.mimeType!=='image/png')throw Error('download_reservation_mismatch');\nconst bytes=await this.helpers.getBinaryDataBuffer(0,'preview');\nif(!bytes||bytes.length<=8||!bytes.subarray(0,8).equals(Buffer.from([137,80,78,71,13,10,26,10])))throw Error('invalid_binary_preview');\nreturn [{json:{media:bytes.toString('base64'),fileName:'previa-'+p.insertionId+'-'+p.revision+'.png'}}];"
      }
    },
