        "jsCode": "const c=$(\"Conferir destino e identidade da reserva\").first().json,a=$input.first().json;\nif(a.sendAllowed===false)return [];\nconst d=a.delivery;\nif(a.sendAllowed!==true||!d||d.status!=='delivery_unknown'||!d.attemptedAt||d.deliveryId!==c.deliveryId||\n d.insertionId!==c.insertionId||d.revision!==c.revision||d.sha256!==c.sha256||d.messageKey!==c.messageKey||\n d.groupJid!==c.groupJid||d.instance!==c.instance||d.adId!==c.adId||d.scheduleId!==c.scheduleId)throw Error('send_attempt_not_confirmed');\nreturn [{json:{ok:true}}];"
      }
