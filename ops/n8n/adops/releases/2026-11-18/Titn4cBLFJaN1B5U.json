    {
      "id": "7cca7a2a-fd32-1d71-ce7e-0e2b2b292df0",
      "name": "Conferir destino e identidade da reserva",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const data=$input.first().json;\nif(data.delivery===null)return [];\nconst c=data.delivery;\nif(!c||typeof c!=='object'||typeof c.deliveryId!=='string'||!/^[a-f0-9-]{36}$/i.test(c.deliveryId)||\n !/^[a-f0-9-]{36}$/i.test(c.claimToken)||c.instance!=='cod5-pmt-pilot')throw Error('invalid_preview_claim_identity');\nif(c.status!=='reserved')return [];\nif(c.mimetype!=='image/png'||c.publicationEnabled!==false||!Number.isSafeInteger(c.adId)||c.adId<=0||!Number.isSafeInteger(c.scheduleId)||c.scheduleId<=0||c.groupJid!==\"120363431261379098@g.us\"||!Number.isSafeInteger(c.insertionId)||c.insertionId<=0||\n !/^[a-f0-9]{64}$/.test(c.revision)||!/^[a-f0-9]{64}$/.test(c.sha256)||\n c.downloadPath!=='/api/insertions/'+c.insertionId+'/visual-previews/'+c.revision+'/download'||\n typeof c.messageKey!=='string'||!c.messageKey||typeof c.caption!=='string'||!c.caption.trim())throw Error('invalid_preview_claim_identity');\nreturn [{json:c}];"
      }
    },
