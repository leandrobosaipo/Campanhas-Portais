              "leftValue": "={{ [3055,3090,3087,3103,3112,3047,3063,3082,3091,3083,3105,3084,3115,3093,3094,3106,3107,3097,3100].includes(Number($json.insertionId)) && /^\\d{4}-\\d{2}-\\d{2}$/.test(String($json.date)) && /^[A-Za-z0-9._:-]{1,160}$/.test(String($json.jobId)) }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
